<script>
// Skills data -> grid
const skills=[["HTML","H5","#E34F26",95],["CSS","C3","#1572B6",90],["JavaScript","JS","#F7DF1E",90],["React.js","⚛","#0b2a3a",85],["Next.js","N","#222",80],["TypeScript","TS","#3178C6",85],["Node.js","No","#3C873A",80],["Tailwind CSS","TW","#0891b2",90],["Git","Git","#F05032",85]];
document.getElementById('skillGrid').innerHTML=skills.map(([n,i,c,p])=>`<div class="card p-5 reveal"><div class="flex items-center gap-3"><span class="tech" style="background:${c};${n==='JavaScript'?'color:#000':''}">${i}</span><b class="flex-1">${n}</b><span class="text-sm text-gray-400">${p}%</span></div><div class="bar mt-4"><i class="grad" data-w="${p}"></i></div></div>`).join('');
try{lucide.createIcons()}catch(e){console.warn('icons failed',e)}

// Scroll reveal + progress bar animation
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');e.target.querySelectorAll('[data-w]').forEach(b=>b.style.width=b.dataset.w+'%');io.unobserve(e.target)}}),{threshold:.15});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

// Mobile menu
const mm=document.getElementById('mmenu');
document.getElementById('burger').onclick=()=>mm.classList.toggle('hidden');
mm.querySelectorAll('a').forEach(a=>a.onclick=()=>mm.classList.add('hidden'));

// Scrollspy for active nav link
const links=[...document.querySelectorAll('.nav-link')],secs=links.map(l=>document.querySelector(l.getAttribute('href')));
const spy=()=>{let cur=0;secs.forEach((s,i)=>{if(s.getBoundingClientRect().top<140)cur=i});links.forEach((l,i)=>l.classList.toggle('active',i===cur))};
addEventListener('scroll',spy,{passive:true});spy();

// Carousel dots
const tr=document.getElementById('track'),dots=document.getElementById('dots'),sl=[...tr.children];
dots.innerHTML=sl.map((_,i)=>`<button class="dot" aria-label="Slide ${i+1}"></button>`).join('');
const ds=[...dots.children];
ds.forEach((d,i)=>d.onclick=()=>tr.scrollTo({left:sl[i].offsetLeft-sl[0].offsetLeft,behavior:'smooth'}));
const upd=()=>{const max=tr.scrollWidth-tr.clientWidth;let i=0;if(max<=4){i=0}else{i=Math.round(tr.scrollLeft/max*(sl.length-1))}ds.forEach((d,k)=>d.classList.toggle('on',k===i))};
tr.addEventListener('scroll',upd,{passive:true});upd();
window.__ok=1;

// 3D transition when opening Task Management App
(function(){
  const link=document.querySelector('a[href*="JVb1UKUv47MdbwVUQhaz8x"]'),w=document.getElementById('warp'),fb=document.getElementById('wfb');
  if(!link)return;
  const close=()=>{w.className='';fb.hidden=true};
  document.getElementById('wx').onclick=close;
  addEventListener('keydown',e=>{if(e.key==='Escape')close()});
  fb.onclick=()=>setTimeout(close,300);
  link.addEventListener('click',e=>{
    e.preventDefault();
    const url=link.href;
    if(matchMedia('(prefers-reduced-motion:reduce)').matches){window.open(url,'_blank');return}
    w.className='on';fb.hidden=true;
    requestAnimationFrame(()=>requestAnimationFrame(()=>w.classList.add('show')));
    setTimeout(()=>w.classList.add('go'),1500);
    setTimeout(()=>{
      let p=null;try{p=window.open(url,'_blank')}catch(_){}
      if(p){try{p.opener=null}catch(_){}setTimeout(close,500)}
      else{w.classList.remove('go');fb.hidden=false}
    },2100);
  });
})();
</script>
</body>
</html>
